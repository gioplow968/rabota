import tkinter as tk

root = tk.Tk()
root.geometry("400x200")

btn = tk.Button(root, text="Движение")
btn.place(x=160, y=80, width=80, height=30)

def move(event):
    x = btn.winfo_x() + event
    if 0 <= x <= 400 - 80:
        btn.place(x=x)

root.bind("<Left>", lambda e: move(-20))
root.bind("<Right>", lambda e: move(20))

root.mainloop()
